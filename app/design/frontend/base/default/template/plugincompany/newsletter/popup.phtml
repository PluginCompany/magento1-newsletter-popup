    <script type="text/javascript">
        var pc_submitted = false;
        if(typeof oldIE == 'undefined'){
            var oldIE = false;
        }

        jQuery(document).ready(function(){
            if(jQuery.cookie('dont_show_newsletter')){
                return false;
            }
            setTimeout(function(){
                if(!oldIE) {
                    jQuery('.pc_newsletter,.pc_overlay').appendTo('body');
                    jQuery('.pc_newsletter').show();
                    jQuery('.pc_overlay').fadeIn();
                    jQuery('.pc_newsletter .inner.left').show();
                    jQuery('.pc_newsletter .inner.right').animate({width:'400px'},1);
                    jQuery('.pc_rightcontent').show();
                    jQuery('.pc_leftcontent').show();
                    jQuery('.pc_newsletter .close').addClass('animated fadeIn').show();
                }else{
                    //old IE animations
                    jQuery('.pc_newsletter,.pc_overlay').appendTo('body');
                    jQuery('.pc_newsletter .inner.left').show();
                    jQuery('.pc_leftcontent').show();
                    jQuery('.pc_newsletter').css('top','-500px').show().animate({top:'10%'},'normal');
                    jQuery('.pc_overlay').show();
                    jQuery('.pc_rightcontent').show();
                    jQuery('.pc_newsletter .inner.right').css('margin-left','-400px').css('width','400px');
                    jQuery('.pc_newsletter .inner.right').delay(500).animate({marginLeft: '0px'}, 'normal',function() {
                        jQuery('.pc_newsletter .close').fadeIn();
                    });
                }
            },(<?php echo $this->getConfig('general/delay');?>000+500))
        });

        jQuery('.pc_newsletter .close,.pc_overlay').click(function(){
            closeNewsletterPopup();
        })

        function closeNewsletterPopup(){
            jQuery('.pc_overlay').fadeOut();
            jQuery('.pc_newsletter').addClass('bounceOutDown');
            if(oldIE) {
                jQuery('.pc_newsletter').fadeOut();
            }
            <?php if (!$this->getConfig('general/show_again_after_close')) { ?>
                jQuery.cookie('dont_show_newsletter', 'yes', { expires: 365, path: '/' });
            <?php } ?>
            <?php if (!$this->getConfig('general/show_again_after_subscribe ')) { ?>
            if(pc_submitted){
                jQuery.cookie('dont_show_newsletter', 'yes', { expires: 365, path: '/' });
            }
            <?php } ?>
        }
        jQuery('#pc_submit').click(function() {
            jQuery('#pc_newsletterform').submit();
        })
        jQuery("#pc_newsletterform").submit(function(e)
        {
            e.preventDefault(); //STOP default action

            var postData = jQuery(this).serializeArray();
            var formURL = jQuery(this).attr("action");
            jQuery.ajax(
                {
                    url : formURL,
                    type: "POST",
                    data : postData,
                    success:function(data, textStatus, jqXHR)
                    {
                        var data = JSON.parse(data);
                        if(data.status == 'success'){
                            jQuery('#pc_msgblock')
                                .removeClass('pc_error')
                                .addClass('pc_success')
                                .text(data.message)
                                .fadeIn();
                            pc_submitted = true;
                            setTimeout(function() {
                                closeNewsletterPopup();
                            },1500)
                        }else if(data.status == 'error'){
                            jQuery('#pc_msgblock')
                                .removeClass('pc_success')
                                .addClass('pc_error')
                                .text(data.message)
                                .fadeIn();
                        }
                        setTimeout(function(){
                            jQuery('#pc_msgblock').fadeOut();
                        },5000)
                    },
                    error: function(jqXHR, textStatus, errorThrown)
                    {
                        jQuery('#pc_msgblock')
                            .removeClass('pc_success')
                            .addClass('pc_error')
                            .text('Internal error occured')
                            .fadeIn();
                        setTimeout(function(){
                            jQuery('#pc_msgblock').fadeOut();
                        },5000)
                    }
                }
                );
            return false;
        });
    </script>