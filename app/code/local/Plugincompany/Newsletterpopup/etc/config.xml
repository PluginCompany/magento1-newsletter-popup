<?xml version="1.0"?>
<config>
    <modules>
        <Plugincompany_Newsletterpopup>
            <version>1.1.0</version>
        </Plugincompany_Newsletterpopup>
    </modules>
    <global>
        <blocks>
            <plugincompany_newsletterpopup>
                <class>Plugincompany_Newsletterpopup_Block</class>
            </plugincompany_newsletterpopup>
        </blocks>
        <helpers>
            <plugincompany_newsletterpopup>
                <class>Plugincompany_Newsletterpopup_Helper</class>
            </plugincompany_newsletterpopup>
        </helpers>
        <models>
            <plugincompany_newsletterpopup>
                <class>Plugincompany_Newsletterpopup_Model</class>
            </plugincompany_newsletterpopup>
        </models>
    </global>
    <frontend>
        <routers>
            <newsletterpopup>
                <use>standard</use>
                <args>
                    <module>Plugincompany_Newsletterpopup</module>
                    <frontName>newsletterpopup</frontName>
                </args>
            </newsletterpopup>
        </routers>
        <layout>
            <updates>
                <plugincompany_newsletterpopup>
                    <file>plugincompany_newsletterpopup.xml</file>
                </plugincompany_newsletterpopup>
            </updates>
        </layout>
    </frontend>
    <default>
        <plugincompany_newsletterpopup>
            <general>
                <enabled>1</enabled>
                <show_again_after_close>0</show_again_after_close>
                <show_again_after_subscribe>0</show_again_after_subscribe>
                <delay>0</delay>
                <show_homepage>1</show_homepage>
                <show_cms>1</show_cms>
                <show_categories>1</show_categories>
                <show_product>1</show_product>
                <show_loggedin>1</show_loggedin>
                <show_guest>1</show_guest>
                <modal>1</modal>
            </general>
            <libraries>
                <jquery>1</jquery>
                <jquery_cookie>1</jquery_cookie>
                <animate_css>1</animate_css>
                <fontawesome>1</fontawesome>
            </libraries>
            <left_column>
                <left_background_clr>#3498db</left_background_clr>
                <left_title>DISCOUNT OFFER</left_title>
                <left_title_color>#FFFFFF</left_title_color>
                <left_title_font_size>25</left_title_font_size>
                <left_text>Subscribe to our newsletter to receive interesting updates and amazing discounts!</left_text>
                <left_top_text_color>#FFFFFF</left_top_text_color>
                <left_top_font_size>20</left_top_font_size>
                <left_icon>fa-thumbs-up</left_icon>
                <left_icon_color>#FFFFFF</left_icon_color>
                <left_icon_size>18</left_icon_size>
                <left_text2>Fill in your e-mail address and stay updated!</left_text2>
                <left_text2_color>#FFFFFF</left_text2_color>
                <left_text2_font_size>20</left_text2_font_size>
            </left_column>
            <right_column>
                <right_background_clr>#ecf0f1</right_background_clr>
                <right_title>SUBSCRIBE</right_title>
                <right_title_color>#2c3e50</right_title_color>
                <right_title_font_size>25</right_title_font_size>
                <right_icon>fa-envelope</right_icon>
                <right_icon_color>#2c3e50</right_icon_color>
                <right_icon_font_size>18</right_icon_font_size>
                <button_text>Subscribe Now</button_text>
                <button_color>#3498db</button_color>
                <button_border_color>#2a8bcc</button_border_color>
                <button_text_color>#ffffff</button_text_color>
                <email_placeholder>Enter your e-mail address</email_placeholder>
                <placeholder_font_size>18</placeholder_font_size>
                <button_text_size>22</button_text_size>
                <close_button>#B0B0B0</close_button>
            </right_column>
        </plugincompany_newsletterpopup>
    </default>
    <adminhtml>
        <events>
            <controller_action_layout_load_before>
                <observers>
                    <plugincompany_newsletterpopup>
                        <type>model</type>
                        <method>controllerActionLayoutLoadBefore</method>
                        <class>plugincompany_newsletterpopup/observer</class>
                    </plugincompany_newsletterpopup>
                </observers>
            </controller_action_layout_load_before>
        </events>
        <layout>
            <updates>
                <plugincompany_newsletterpopup>
                    <file>plugincompany_newsletterpopup.xml</file>
                </plugincompany_newsletterpopup>
            </updates>
        </layout>
    </adminhtml>
</config>